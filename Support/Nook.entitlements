<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks the microphone without this. Nothing else is needed: the app is
	     not sandboxed, loads no third-party code, and launching `claude` needs no entitlement. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
